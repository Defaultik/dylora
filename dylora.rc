// Executable icon (shown in Explorer, taskbar, Alt-Tab, window title bar).
// The lowest-numbered ICON in the resources becomes the .exe's default icon.
101 ICON "dylora.ico"

// Version resource. FileDescription is what modern Task Manager shows in the
// "Name" column instead of the raw image file name (Dylora.exe).
1 VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",     "Defaultik"
            VALUE "FileDescription", "Dylora"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "InternalName",    "Dylora"
            VALUE "OriginalFilename","Dylora.exe"
            VALUE "ProductName",     "Dylora"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
